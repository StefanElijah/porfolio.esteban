---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import Code from "./icons/Code.astro"
import LinkButton from "./LinkButton.astro"
import projectsData from "@/data/projects.json"

const TAGS: Record<string, { name: string; class: string; icon: any }> = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  REACT: {
    name: "React",
    class: "bg-[#087EA4] text-white",
    icon: Code,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-[#3178C6] text-white",
    icon: Code,
  },
  JAVA: {
    name: "Java",
    class: "bg-[#ED8B00] text-white",
    icon: Code,
  },
  SPRING: {
    name: "Spring Boot",
    class: "bg-[#6DB33F] text-white",
    icon: Code,
  },
  DOCKER: {
    name: "Docker",
    class: "bg-[#2496ED] text-white",
    icon: Code,
  },
  NESTJS: {
    name: "NestJS",
    class: "bg-[#E0234E] text-white",
    icon: Code,
  },
  PRISMA: {
    name: "Prisma",
    class: "bg-[#2D3748] text-white",
    icon: Code,
  },
  POSTGRESQL: {
    name: "PostgreSQL",
    class: "bg-[#4169E1] text-white",
    icon: Code,
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-[#4479A1] text-white",
    icon: Code,
  },
  MARIADB: {
    name: "MariaDB",
    class: "bg-[#003545] text-white",
    icon: Code,
  },
  REDIS: {
    name: "Redis",
    class: "bg-[#DC382D] text-white",
    icon: Code,
  },
  RABBITMQ: {
    name: "RabbitMQ",
    class: "bg-[#FF6600] text-white",
    icon: Code,
  },
  KAFKA: {
    name: "Apache Kafka",
    class: "bg-[#231F20] text-white",
    icon: Code,
  },
  KEYCLOAK: {
    name: "Keycloak",
    class: "bg-[#008AAA] text-white",
    icon: Code,
  },
  MINIO: {
    name: "MinIO",
    class: "bg-[#C72C48] text-white",
    icon: Code,
  },
  ANGULAR: {
    name: "Angular",
    class: "bg-[#DD0031] text-white",
    icon: Code,
  },
  TERRAFORM: {
    name: "Terraform",
    class: "bg-[#7B42BC] text-white",
    icon: Code,
  },
  AWS: {
    name: "AWS",
    class: "bg-[#FF9900] text-white",
    icon: Code,
  },
  AZURE: {
    name: "Azure",
    class: "bg-[#0078D4] text-white",
    icon: Code,
  },
  NEXTAUTH: {
    name: "NextAuth.js",
    class: "bg-black text-white",
    icon: Code,
  },
  KUBERNETES: {
    name: "Kubernetes",
    class: "bg-[#326CE5] text-white",
    icon: Code,
  },
  PLAYWRIGHT: {
    name: "Playwright",
    class: "bg-[#2EAD33] text-white",
    icon: Code,
  },
  SONARCLOUD: {
    name: "SonarCloud",
    class: "bg-[#4E9BCD] text-white",
    icon: Code,
  },
  OPENTELEMETRY: {
    name: "OpenTelemetry",
    class: "bg-[#425CC7] text-white",
    icon: Code,
  },
  NX: {
    name: "Nx",
    class: "bg-[#143055] text-white",
    icon: Code,
  },
  MSAL: {
    name: "MSAL",
    class: "bg-[#5E5E5E] text-white",
    icon: Code,
  },
}

const PROJECTS = projectsData.map((project) => ({
  ...project,
  tags: project.tags.map((key) => TAGS[key]),
}))
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(251,191,36,0.2)] lg:border lg:border-gray-800 lg:hover:border-yellow-400/30 lg:hover:bg-gray-800/50">
            {image ? (
              <img
                alt={title}
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                src={image}
              />
            ) : (
              <div class="flex h-56 w-full items-center justify-center bg-gradient-to-br from-yellow-400/20 via-gray-200 to-gray-100 dark:from-yellow-400/10 dark:via-gray-800 dark:to-gray-900 sm:h-72">
                <span
                  class="text-5xl font-bold text-yellow-500 dark:text-yellow-300"
                  aria-hidden="true"
                >
                  {title.charAt(0)}
                </span>
              </div>
            )}
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              aria-hidden="true"
            >
            </div>
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <ul class="flex flex-row flex-wrap mt-3 gap-2">
            {tags.map((tag) => (
              <li>
                <span
                  class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
                >
                  <tag.icon class="size-4" />
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <p class="mt-3 text-gray-700 dark:text-gray-400 text-pretty">
            {description}
          </p>
          <footer class="flex items-center mt-4 gap-x-4">
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-5" />
                Code
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link}>
                <ExternalLink class="size-4" />
                Preview
              </LinkButton>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>
