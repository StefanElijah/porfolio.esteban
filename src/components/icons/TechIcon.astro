}

const { name, class: className } = Astro.props
const icon = ICONS[name]
---

{
  name === "NEXTAUTH" ? (
    <ProfileCheck class={className} aria-hidden="true" />
  ) : icon ? (
    <svg
      class={className}
      viewBox={icon.viewBox ?? "0 0 24 24"}
      fill="currentColor"
      aria-hidden="true"
    >
      <path d={icon.path} />
    </svg>
  ) : (
    <Code class={className} aria-hidden="true" />
  )
}
