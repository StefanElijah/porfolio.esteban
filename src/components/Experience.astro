---
import ExperienceItem from "./ExperienceItem.astro"
import experienceData from "@/data/experience.json"

interface ExperienceEntry {
  date: string
  title: string
  company: string
  description: string
  link?: string
  current?: boolean
}

const experience = experienceData as ExperienceEntry[]
---

<ol class="relative mt-16" aria-label="Experiencia laboral">
  {
    experience.map((exp, i) => (
      <li class="anim-fade-in" style={`animation-delay: ${i * 150}ms`}>
        <ExperienceItem {...exp} />
      </li>
    ))
  }
</ol>
